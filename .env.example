# Copy to .env (never commit .env). All values below are SAFE PLACEHOLDERS for local trials.
# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
# REQUIRED - the prod settings refuse a missing/placeholder key. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
SITE_URL=http://localhost:8080
# Local plain-http trial only. In production keep SSL redirect on and cookies Secure.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
LOG_JSON=false

# ── Database / Redis (docker compose overrides host names) ───────────────────
POSTGRES_USER=coffee
POSTGRES_PASSWORD=coffee
POSTGRES_DB=coffee
DATABASE_URL=postgres://coffee:coffee@127.0.0.1:5432/coffee
REDIS_URL=redis://127.0.0.1:6379/0

# ── Store defaults (StoreSettings in the dashboard overrides at runtime) ─────
STORE_BRAND_NAME=Lantern Coffee Roasters
STORE_CURRENCY=USD
STORE_TIME_ZONE=UTC
UNPAID_ORDER_EXPIRY_MINUTES=30
# Cash orders the branch never confirms are cancelled after this long (scheduled orders: later of this and slot start minus prep time).
CASH_ORDER_EXPIRY_MINUTES=120
# Unconfirmed (PENDING) cash orders one customer may hold at once; the next checkout / switch to cash answers 409 too_many_open_cash_orders.
MAX_OPEN_CASH_ORDERS_PER_CUSTOMER=3

# ── Payments ──────────────────────────────────────────────────────────────────
# Providers: demo (sandbox simulator, no real money), cash (pay at handover), stripe (official SDK, test or live keys)
PAYMENT_PROVIDERS_ENABLED=demo,cash
PAYMENT_DEMO_ENABLED=true
# Production refuses the demo adapter unless explicitly allowed AND given a unique secret:
ALLOW_DEMO_PAYMENTS_IN_PRODUCTION=true
PAYMENT_DEMO_WEBHOOK_SECRET=local-trial-demo-secret-change-me
# To use Stripe TEST mode: add "stripe" to PAYMENT_PROVIDERS_ENABLED and fill these from https://dashboard.stripe.com/test/apikeys
# (the webhook secret comes from `stripe listen --forward-to localhost:8080/api/v1/payments/webhooks/stripe/` or a dashboard endpoint)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
# Default writes emails to the container log (NOT real delivery). For SMTP use smtp.EmailBackend and fill the rest.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Lantern Coffee <hello@lantern.example>

# ── Docker compose ────────────────────────────────────────────────────────────
WEB_PORT=8080
# Set to 1 on first boot to load the demo catalogue/users/orders (development-only credentials — see docs/seed-data.md)
SEED_DEMO=0
# Demo accounts password (used only by the seed command)
DEMO_PASSWORD=Lantern-demo-2026!

# ── Rate limits (DRF format) — defaults shown; raise only for automated test environments ──
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=10/hour
